{
  "manifest_version": 3,
  "name": "Word Hover IPA",
  "version": "1.0",
  "description": "Hover any word to see its IPA phonetic transcription",
  "action": {
    "default_title": "IPA Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>", "file:///*"],
  "web_accessible_resources": [
    { "resources": ["default-dict.txt"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["popup.css"],
      "js": ["content.js"]
    }
  ]
}
